# Copy this file to .env and fill in what you need. Every line is optional.

# The AI verse check (rule 5.7). Without a key the game still runs; it just asks players for
# more of the wording instead of guessing paraphrases. Keys never reach the browser.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Where the game listens.
# PORT=8787
# HOST=0.0.0.0

# Where the database lives (one SQLite file). Defaults to ./var
# DATA_DIR=./var

# The date of puzzle #1, as YYYY-MM-DD. Defaults to today on the first start, and is then fixed.
# LAUNCH_DATE=2026-11-16

# Print every request (1) and allow the clock to be moved for testing (never in production).
# LOG=1
# BH_DEV_TOOLS=1
